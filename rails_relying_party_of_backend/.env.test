# テスト専用の環境変数（dotenv-rails は test 環境で .env より先に読み、先に読んだ値が勝つ）
# 外部への通信は WebMock で遮断・差し替えるので、どの値も実在のサーバーやアプリには使わない
CLIENT_ID_OF_MY_OP=test-dummy-rp-my-op-client-id
CLIENT_SECRET_OF_MY_OP=test-dummy-rp-my-op-client-secret
ISSUER_OF_MY_OP=http://localhost:3780
OIDC_PROVIDER_HOST=http://localhost:3780
CLIENT_ID_OF_INTROSPECTION=test-dummy-rp-introspection-client-id
CLIENT_SECRET_OF_INTROSPECTION=test-dummy-rp-introspection-client-secret
