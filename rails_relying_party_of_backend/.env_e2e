# E2E 専用の環境変数。e2e/playwright.config.ts が読み、RP の起動時に渡す（dotenv は既存の値を上書きしないので .env より優先される）
# client_id / secret は rails_open_id_provider/db/seeds.rb で作る E2E 用のダミー値
CLIENT_ID_OF_MY_OP=e2e-dummy-rp-my-op-client-id
CLIENT_SECRET_OF_MY_OP=e2e-dummy-rp-my-op-client-secret
ISSUER_OF_MY_OP=http://localhost:3780
OIDC_PROVIDER_HOST=http://localhost:3780
CLIENT_ID_OF_INTROSPECTION=e2e-dummy-rp-introspection-client-id
CLIENT_SECRET_OF_INTROSPECTION=e2e-dummy-rp-introspection-client-secret
