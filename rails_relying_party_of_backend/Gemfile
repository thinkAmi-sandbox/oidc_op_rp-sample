# frozen_string_literal: true

source 'https://rubygems.org'
git_source(:github) { |repo| "https://github.com/#{repo}.git" }

ruby '4.0.9'

# config/application.rb や gem の require が、起動の途中で Rails の部品（ActiveRecord::Base など）を読み込むと検出する。
# ほかの gem の initializer と config/initializers は検出できない（docs/upgrade/PLAN.md の Step 1-b-1）。
# 環境変数 ANTI_MANNER があるときだけ動く。ほかの gem より先に Bundler.require で読ませるため、先頭に置く
gem 'a-nti_manner_kick_course', groups: %i[development test]

# Bundle edge Rails instead: gem 'rails', github: 'rails/rails', branch: 'main'
gem 'rails', '~> 8.1.4'
# Use sqlite3 as the database for Active Record
gem 'sqlite3', '~> 2.9'
# Use Puma as the app server
gem 'puma', '~> 8.0'
# Build JSON APIs with ease. Read more: https://github.com/rails/jbuilder
gem 'jbuilder', '~> 2.7'
# Use Redis adapter to run Action Cable in production
# gem 'redis', '~> 4.0'
# Use Active Model has_secure_password
# gem 'bcrypt', '~> 3.1.7'

# Use Active Storage variant
# gem 'image_processing', '~> 1.2'

# Reduces boot times through caching; required in config/boot.rb
gem 'bootsnap', '>= 1.4.4', require: false

group :development, :test do
  # Call 'byebug' anywhere in the code to stop execution and get a debugger console
  gem 'byebug', platforms: %i[mri windows]

  # 静的解析と脆弱性チェック。rubocop 系はバージョンを固定し、更新は単独のコミットで行う
  gem 'brakeman', require: false
  gem 'bundler-audit', require: false
  gem 'rubocop', '1.92.1', require: false
  gem 'rubocop-minitest', '0.41.0', require: false
  gem 'rubocop-rails', '2.38.0', require: false
end

group :development do
  # Access an interactive console on exception pages or by calling 'console' anywhere in the code.
  gem 'web-console', '>= 4.1.0'
  # Display performance information such as SQL time and flame graphs for each request in your browser.
  # Can be configured to work on production as well see: https://github.com/MiniProfiler/rack-mini-profiler/blob/master/README.md
  gem 'rack-mini-profiler', '~> 5.0'
end

group :test do
  # activesupport の依存。5.14.4 は Ruby 4.0 に入らない（required_ruby_version が < 4.0）ので、Rails 8.1.4 が使う
  # 6 系の版を明示する（docs/upgrade/PLAN.md の Step 9）
  gem 'minitest', '6.0.6', require: false
  # カバレッジの計測と、外部への HTTP 通信の遮断・差し替え
  gem 'simplecov', require: false
  gem 'webmock', require: false
end

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem 'tzinfo-data', platforms: %i[windows jruby]

# 追加
# omniauthまわり
gem 'omniauth'
gem 'omniauth-oauth2'
gem 'omniauth-rails_csrf_protection'

# 独自ストラテジー（lib/omniauth/strategies/my_op.rb）で ID トークンを検証するため
gem 'jwt'

# OP の JWKS の取得（lib/omniauth/strategies/my_op.rb）と、introspection 画面からの RS・OP の呼び出しのため
gem 'faraday'

# セッションの中身を見やすくするよう、セッションを ActiveRecord で管理
gem 'activerecord-session_store'

# OPからもらった client_id と client_secret を .env ファイルから読み込むため
gem 'dotenv-rails', groups: %i[development test]

# Ruby 4.0 の default gem の json（2.18.0）は CVE-2026-54696・CVE-2026-33210 の対象なので、修正版を明示する。
# json 3 は既定値が変わる（重複キー・コメントで例外）ので、2 系にとどめる（docs/upgrade/PLAN.md の Step 8）
gem 'json', '~> 2.21', '>= 2.21.2'

# actionpack などの依存。rack 3 への更新は別の作業で行うので、それまで 2 系にとどめる（2.2 系の修正版は受け取る）。
# 起動の途中では読み込まない（docs/upgrade/PLAN.md の仕上げの「間接の依存の gem で決めたこと」）
gem 'rack', '~> 2.2', '>= 2.2.24', require: false

# rake 13.0.6 が require "ostruct" する。Ruby 4.0 の bundled gems で、lock にないと読み込めないので明示する。
# 版は Ruby 4.0.9 の bundled gems と同じにする。起動の途中では読み込まない（docs/upgrade/PLAN.md の Step 8・Step 9）
gem 'ostruct', '0.6.3', require: false

# lock にある Ruby の default gem・bundled gems のうち、版を Ruby に合わせ直してきたもの（docs/upgrade/PLAN.md の 7 章・8 章の 4）は、
# Ruby 4.0.9 が持つ版と同じにする。Ruby を上げるときに版を合わせ直し、まだ依存されているかを見直す。起動の途中では読み込まない
gem 'base64', '0.3.0', require: false
gem 'bigdecimal', '4.0.1', require: false
gem 'drb', '2.2.3', require: false
gem 'erb', '6.0.7', require: false
gem 'io-console', '0.8.2', require: false
gem 'irb', '1.16.0', require: false
gem 'logger', '1.7.0', require: false
gem 'net-http', '0.9.1', require: false
gem 'pp', '0.6.3', require: false
gem 'prettyprint', '0.2.0', require: false
gem 'psych', '5.3.1', require: false
gem 'rdoc', '7.0.4', require: false
gem 'reline', '0.6.3', require: false
gem 'securerandom', '0.4.1', require: false
gem 'stringio', '3.2.0', require: false
gem 'tsort', '0.2.0', require: false
gem 'uri', '1.1.1', require: false
