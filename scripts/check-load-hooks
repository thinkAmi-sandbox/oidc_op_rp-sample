#!/usr/bin/env bash
# 起動の途中の読み込み（a-nti_manner_kick_course）を、アプリのディレクトリで `bin/rails runner 1` に流して確かめる。
# scripts/check-apps と CI（.github/workflows/ci.yml）の「起動の途中の読み込み」から呼ぶ。RAILS_ENV などは呼ぶ側で渡す。
#
# 使い方（アプリのディレクトリで）:
#   RAILS_ENV=test ../scripts/check-load-hooks
#
# 検出がなければ終了コード 0、あれば 1。ただし、下の KNOWN に当たる検出は、知っているものとして終了コード 0 にする。
# gem は最初の 1 件で止まるので、許した検出の後ろにある検出は見えない。許している間は、各作業の前後で
# scripts/compare-config の「読み込み済みの部品」を比べて補う。
#
# KNOWN（hook と行の組。どちらも出たときだけ許す）:
#   1. omniauth-rails_csrf_protection 2.0.1（RP）は、Rails 8.1 では require の時点で ActionController::Base を読み込む。
#      Rails 8.1 用の分岐が、`config` を ActionController::Base.config にしてから RequestForgeryProtection を include し、
#      その included ブロックが `config` を呼ぶため（cookpad/omniauth-rails_csrf_protection#33。open）。
#      その間、RP の config/initializers に書いた action_controller の設定は ActionController::Base に届かない。
#      直った版が出たら上げて、この組を消す（docs/upgrade/PLAN.md の 6 章の Step 7 と 7 章、docs/IMPROVEMENTS.md の IMP-009）。
#      gem の版と行で絞っているので、gem を上げるとこの検出も失敗になる。そのときは、同じ分岐による検出かを
#      ANTI_MANNER_DEBUG のスタックトレースで確かめてから、行を直すか組を消す

set -u

KNOWN_HOOKS=(
  'ActiveSupport.on_load(:action_controller_base)'
)
KNOWN_LINES=(
  'omniauth-rails_csrf_protection-2.0.1/lib/omniauth/rails_csrf_protection/token_verifier.rb:26:'
)
KNOWN_NAMES=(
  'omniauth-rails_csrf_protection 2.0.1 の Rails 8.1 用の分岐。cookpad/omniauth-rails_csrf_protection#33'
)

output="$(ANTI_MANNER=1 ANTI_MANNER_DEBUG=1 bin/rails runner 1 2>&1)"
status=$?

if [ "$status" -eq 0 ]; then
  echo "$output"
  exit 0
fi

for i in "${!KNOWN_HOOKS[@]}"; do
  if grep -qF "${KNOWN_HOOKS[$i]}" <<<"$output" && grep -qF "${KNOWN_LINES[$i]}" <<<"$output"; then
    echo "許している検出（${KNOWN_NAMES[$i]}）だけが出た"
    echo "この検出の後ろにある検出は見えない。scripts/compare-config の「読み込み済みの部品」で補う"
    exit 0
  fi
done

# 許していない検出は、gem の短い表示（疑わしい行）で出し直す。ANTI_MANNER_DEBUG の表示は、スタックトレースが 1 行の配列になる
ANTI_MANNER=1 bin/rails runner 1 2>&1
echo
echo "== スタックトレース全体（ANTI_MANNER_DEBUG）"
echo "$output"
exit 1
